---
interface Props {
  targetDate: string | Date;
  fallback?: string;
  class?: string;
}

const { targetDate, fallback = "--", class: className = "" } = Astro.props;

// Standardize target to an ISO string for HTML data attributes
const targetString = typeof targetDate === "string" 
  ? targetDate 
  : targetDate.toISOString();
---

<span 
  class:list={["countdown-display", className]} 
  data-countdown-target={targetString}
>
  {fallback}
</span>

<script>
  function updateCountdowns() {
    const countdownElements = document.querySelectorAll<HTMLElement>("[data-countdown-target]");
    const now = Date.now();

    countdownElements.forEach((el) => {
      const targetStr = el.dataset.countdownTarget;
      if (!targetStr) return;

      const targetTime = new Date(targetStr).getTime();
      const difference = targetTime - now;

      // Calculate days clamped to 0
      const days = Math.max(0, Math.floor(difference / (1000 * 60 * 60 * 24)));
      el.textContent = days.toString();
    });
  }

  // Update immediately on page load
  updateCountdowns();

  // Re-check every minute for rollover
  setInterval(updateCountdowns, 60000);

  // Re-run if you navigate with Astro's View Transitions
  document.addEventListener("astro:page-load", updateCountdowns);
</script>