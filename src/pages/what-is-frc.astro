---
import BaseLayout from "../layouts/BaseLayout.astro";

const currentDate: Date = new Date();
const kickoffDate: Date = new Date("2027-01-09");
const daysTillKickoff: number = Math.max(
    0,
    Math.floor(
        (kickoffDate.getTime() - currentDate.getTime()) / (1000 * 60 * 60 * 24),
    ),
);
---

<BaseLayout>
    <section id="hero" class="hero-layout">
        <h1>What is FRC?</h1>
        <p class="subtitle">
            FIRST Robotics Competition (FRC) is a worldwide high-school robotics
            tournament, where student led teams compete in a new game yearly.
            Combining STEM education with sporting intensity, FRC empowers
            ambitious students to collaborate with peers, learn real world
            skills and tackle engineering under pressure.
        </p>
    </section>
    
    <section id="season-timeline" class="content-section">
        <h2>Throughout a Season</h2>
        <div class="card-grid">
            <div class="timeline-card">
                <div class="milestone">
                    <span class="milestone-number">01</span>
                    <h3>Kickoff <span>(January)</span></h3>
                </div>
                <p>
                    In {daysTillKickoff} days, the 2027 season begins with a release
                    video and game manual manual on the <a
                        href="https://www.firstinspires.org/programs/frc/"
                        >FIRST website</a
                    >. With no prior knowledge, teams start strategising and
                    prototyping for different aspects of the game.
                </p>
            </div>
            <div class="timeline-card">
                <div class="milestone">
                    <span class="milestone-number">02</span>
                    <h3>Build Season <span>(Jan - March)</span></h3>
                </div>
                <p>
                    Teams work intensely, often 20-30 hours per week. During the
                    season students design, manufacture, and program their robot
                    for competiton. Working alongside mentors, they build a
                    battle-ready machine.
                </p>
            </div>
            <div class="timeline-card">
                <div class="milestone">
                    <span class="milestone-number">03</span>
                    <h3>Competitions <span>(March - April)</span></h3>
                </div>
                <p>
                    Working in randomised alliances of three each match, teams
                    coordinate strategy and compete on a basketball-court sized
                    field. Between games, they repair damages in pit and
                    optimise software on the fly to qualify for Worlds.
                </p>
            </div>
            <div class="timeline-card">
                <div class="milestone">
                    <span class="milestone-number">04</span>
                    <h3>Off Season <span>(April - Next Jan)</span></h3>
                </div>
                <p>
                    Until next kickoff, students learn new things, improve their bot, prepare for recruitment, and more. In this time, teams reflect on their season and progress. Sometimes, they will compete in off-season competitions.  
                </p>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .hero-layout {
        text-align: center;
    }

    .timeline-card {
        background-color: var(--card-bg);
        padding: 2rem;
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .milestone {
        display: flex;
        flex-direction: row;
        gap: 0.75rem;
        align-items: center;
    }

    .milestone > span {
        font-family: "Space Grotesk", sans-serif;
        font-weight: 600;
        font-size: 1.6rem;
        color: var(--text-muted);
    }

    .milestone > h3 {
        margin: 0;
    }

    .milestone > h3 > span {
        display: block;
        color: var(--text-muted);
    }
</style>
