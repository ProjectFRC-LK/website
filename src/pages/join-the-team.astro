---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
    <section id="eoi-section" class="content-section">
        <div class="eoi-container">
            <iframe src="https://forms.gle/3fjmBShiWUtEgTFE6"></iframe>
        </div>
    </section>
</BaseLayout>

<style>
    .eoi-container {
        height: clamp(32rem, 75vh, 1200px);
        width: 100%;
    }
    .eoi-container > iframe {
        width: 100%;
        height: 100%;
        border: 0;
    }
</style>
