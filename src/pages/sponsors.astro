---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
    <section id="hero">
        <h1>Sponsors</h1>
        <p>
            Donations and commitments to STEM are what allows a team to survive.
            Through monetary, equipment access, or workspace contributions you
            can make Sri Lanka's first FRC team a reality.
        </p>
    </section>
    <section id="sponsor-us" class="content-section solid-bg">
        <h2>Become a Sponsor</h2>
        <p>
            Contributing in any way is gratefully accepted. By sponsoring us
            through a workshop, access to equipment and tools, or financial
            support you are empowering future STEM leaders.
        </p>
        <a href="mailto:enquiries@projectfrc.lk" class="button-link">Get in Contact</a>
    </section>
</BaseLayout>

<style>
    ul {
        list-style-type: square;
        padding-left: 1rem;
    }
</style>
