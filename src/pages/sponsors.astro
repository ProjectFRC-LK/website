---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";

import dbugWithRobot from "../assets/dbug-team-with-robot.jpeg";
---

<BaseLayout>
    <section class="hero-layout">
        <div class="hero-content">
            <h1>Sponsor and inspire Sri Lanka's next innovators</h1>
            <p class="subtitle">
                Robotics requires significant capital, but the return on
                investment is a transformed workforce. By partnering with us,
                you inspire the future workforce to pursue skills aligned with
                your company, cultivating the opportunity to take on highly
                capable, university-ready interns.
            </p>
            <p class="subtitle emphasis">
                Whether it is monetary funding, access to equipment such as CNC
                machines, or mentoring, <strong>
                    any form of contribution advances our mission and is greatly
                    appreciated</strong
                >.
            </p>
            <a
                href="mailto:enquiries@projectfrc.lk"
                class="button-link sponsor-btn-massive">Partner With Us</a
            >
        </div>

        <div class="image-container">
            <Image
                src={dbugWithRobot}
                alt="FRC Team D-Bug standing around their robot"
                class="rounded-image"
                width={1200}
                height={1600}
            />
        </div>
    </section>

    <section id="sponsor-tiers" class="content-section">
        <h2>How Your Support Builds the Future</h2>
        <div class="card-grid">
            <div class="card outline-card">
                <h3>Financial Grants</h3>
                <p>
                    Your financial support directly funds our initial US$6,300
                    international registration fee and essential hardware. This
                    ensures passionate Sri Lankan youth have a concrete pathway
                    to higher-level STEM education.
                </p>
            </div>
            <div class="card outline-card">
                <h3>In-Kind Fabrication</h3>
                <p>
                    Competitive robotics at the FRC level requires machinery. We seek
                    generous partners who can provide access to industry tools such
                    as CNC milling, raw aluminum, or a workspace in
                    Colombo.
                </p>
            </div>
            <div class="card outline-card">
                <h3>Technical Mentorship</h3>
                <p>
                    We need STEM professionals to guide students
                    in software, mechanical design, and general engineering. By investing in the
                    future workforce, you are actively building a direct pipeline of capable
                    future talent for your company.
                </p>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .hero-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
        align-items: center;
        margin-top: 2rem;
        margin-bottom: 4rem;
    }

    .hero-content {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .subtitle {
        color: var(--text-muted);
        font-size: 1.1rem;
        line-height: 1.6;
    }

    .emphasis {
        color: var(--white);
        border-left: 4px solid var(--cinnabar);
        padding-left: 1rem;
        background: rgba(171, 49, 45, 0.1);
        padding: 1rem;
        border-radius: 0 8px 8px 0;
    }

    .image-container {
        width: 100%;
        height: 100%;
    }

    .rounded-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 12px;
        border: 2px solid var(--cinnabar);
        box-shadow: 0 10px 30px rgba(171, 49, 45, 0.15);
    }

    .sponsor-btn-massive {
        font-size: 1.25rem;
        padding: 1rem 2.5rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        box-shadow: 0 4px 15px rgba(171, 49, 45, 0.4);
        width: clamp(100%, 70vh);
    }

    .brand-border {
        border-color: rgba(171, 49, 45, 0.3);
    }

    .brand-border:hover {
        border-color: var(--cinnabar);
    }

    .text-brand {
        color: var(--cinnabar);
    }

    @media (max-width: 768px) {
        .hero-layout {
            grid-template-columns: 1fr;
        }
    }
</style>
